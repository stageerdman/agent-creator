# Secrets — never commit
.env

# Dependencies (the app itself has none; walkthrough tools are installed --no-save)
node_modules/
package-lock.json

# Live walkthrough scratch (agent home it creates, local probes)
.walkthrough-home/
.scratch/
.scratch-home/
# Browser-check screenshots (scripts live in updates/*/checks/)
.tmp-test/

# The built macOS app (npm run build:app): staged code, Tauri build output,
# icons drawn at build time by scripts/stage-mac-app.mjs
dist/
src-tauri/target/
src-tauri/gen/
src-tauri/icons/

# OS / editor
.DS_Store

# Python
__pycache__/
*.py[cod]

# nuwa-skill's version-check bookkeeping file (local, not part of the method)
.last-update-check

# Raw source material (copyrighted books/transcripts/etc) a person provides —
# local-corpus input for distillation, kept out of git per CLAUDE.md's rule
# on sensitive source dumps. Research notes derived FROM it still get committed.
.claude/skills/*/references/sources/

# Merged RAG knowledge base — same sensitivity as the sources it's built from
knowledge.md
.claude/skills/*/knowledge.md
